# 실제 값은 절대 커밋하지 마세요. 이 파일을 복사해 `.env.local` 등으로 사용하세요.
#
# Postgres 연결 문자열 (Neon 등). 비밀번호·호스트는 본인 것으로 교체.
# 예시 형식만 보여 주기 위해 비밀번호는 *** 로 가렸습니다.
DATABASE_URL=postgresql://USER:***@YOUR-HOST.example/YOUR_DB?sslmode=require

# Vercel Postgres 연동 시 자동으로 들어오는 이름을 쓰는 경우도 있습니다.
# POSTGRES_URL=postgresql://USER:***@YOUR-HOST.example/YOUR_DB?sslmode=require

# (선택) Cron 수동 호출 시 Authorization: Bearer … 검증용. 운영에서는 강한 난수로 설정.
# CRON_SECRET=***
