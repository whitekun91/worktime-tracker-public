# Never commit real values. Copy this file to `.env.local` (or similar).
#
# Postgres URL (Neon, etc.). Replace USER, host, and DB with yours.
# Password is shown as *** for illustration only.
DATABASE_URL=postgresql://USER:***@YOUR-HOST.example/YOUR_DB?sslmode=require

# Some hosts inject this name automatically for Postgres.
# POSTGRES_URL=postgresql://USER:***@YOUR-HOST.example/YOUR_DB?sslmode=require

# Optional: verify `Authorization: Bearer …` on manual cron calls. Use a strong random value in production.
# CRON_SECRET=***

# Optional: Google Calendar "today" panel (server-side).
# Keep keys private and set in deployment environment variables.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=
